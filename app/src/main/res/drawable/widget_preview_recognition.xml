        android:pathData="M55,0 L65,0 A55,55 0,0,1 120,55 A55,55 0,0,1 65,110 L55,110 A55,55 0,0,1 0,55 A55,55 0,0,1 55,0 Z" />

    <!-- The five bars at rest, each a stadium 10.6 wide, h tall. -->
    <group android:translateX="16" android:translateY="48.1">
        <path android:fillColor="#9EFFFFFF" android:pathData="M0,5.3 A5.3,5.3 0,0,1 10.6,5.3 L10.6,8.5 A5.3,5.3 0,0,1 0,8.5 L0,5.3 Z" />
